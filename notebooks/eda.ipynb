# [Cell 1] Imports & Setup
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# [Cell 2] Class Imbalance Analysis
train_df = pd.read_csv('../data/splits/train.csv') if False else pd.read_csv('/kaggle/working/train.csv')
with open('/kaggle/working/top50_tags.txt') as f:
    top50_tags = [l.strip() for l in f if l.strip()]

tag_counts = train_df[top50_tags].sum().sort_values(ascending=False)

plt.figure(figsize=(12, 5))
sns.barplot(x=tag_counts.index[:25], y=tag_counts.values[:25], palette="viridis")
plt.xticks(rotation=45, ha='right')
plt.title("Top 25 Tag Distribution (MagnaTagATune Train Subset)")
plt.ylabel("Positive Clip Count")
plt.tight_layout()
plt.show()
